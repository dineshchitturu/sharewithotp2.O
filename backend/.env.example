# ShareWithOTP - Environment Configuration
# Backend Server Configuration
ROOM_EXPIRY_SECONDS=900
OTP_EXPIRY_SECONDS=900
MAX_OTP_ATTEMPTS=5
CLEANUP_INTERVAL_SECONDS=30
JWT_SECRET=temporary-p2p-session-secret-change-in-prod

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# WebRTC STUN Server
STUN_SERVER_URL=stun:stun.l.google.com:19302

# Phase 2 TURN Server Settings (Optional fallback)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
