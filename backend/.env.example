# ShareWithOTP - Environment Configuration
# Backend Server Configuration
ROOM_EXPIRY_SECONDS=900
OTP_EXPIRY_SECONDS=900
MAX_OTP_ATTEMPTS=5
CLEANUP_INTERVAL_SECONDS=30
JWT_SECRET=temporary-p2p-session-secret-change-in-prod

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://sharewithotp2-o-1.onrender.com","https://sharewithotp2-o.onrender.com"]

# WebRTC STUN Server (default: Google STUN)
STUN_SERVER_URL=stun:stun.l.google.com:19302

# WebRTC TURN Server Settings (Required for cross-network transfers behind Symmetric NAT / CGNAT)
# Set your real TURN provider credentials (e.g. Metered, Twilio, Coturn, Xirsys)
# Can be a single URL or comma-separated list of URLs (e.g. turn:relay.metered.ca:80,turn:relay.metered.ca:443?transport=tcp)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
